{
  "name": "oucl",
  "version": "0.0.0",
  "private": true,
  "description": "OUCL desktop launcher engineering foundation",
  "type": "module",
  "main": "dist/main/index.cjs",
  "packageManager": "pnpm@12.3.4",
  "engines": { "node": ">=24.21.0 <25" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts vite.config.ts",
    "test": "node scripts/test.mjs",
    "test:spikes": "node --test spikes/phase0-local/storage.test.mjs spikes/phase0-local/trust.test.mjs spikes/phase0-local/recovery.test.mjs spikes/phase0-local/cross-volume.test.mjs spikes/phase0-local/lease.test.mjs",
    "test:electron-sqlite": "node spikes/electron-sqlite/run.mjs",
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "smoke": "node scripts/smoke.mjs",
    "package:dir": "pnpm build && node scripts/package.mjs",
    "smoke:package": "node scripts/package-smoke.mjs",
    "audit:licenses": "node scripts/audit-dependencies.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5"
  }
}
